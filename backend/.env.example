# CricketConnect Backend Environment Variables

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cricketconnect
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=cricketconnect

# Redis (Local or Upstash)
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_SECRET=super_secret_cricketconnect_jwt_key_2026_dev
JWT_EXPIRES_IN=7d

# Cloudinary (Optional for ground photo uploads)
CLOUDINARY_CLOUD_NAME=demo
CLOUDINARY_API_KEY=123456789
CLOUDINARY_API_SECRET=abcdef12345
